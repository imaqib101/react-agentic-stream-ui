{
  "name": "@imaqib101/react-agentic-stream-ui",
  "version": "1.0.0",
  "description": "Composable React component primitives & streaming state hooks for generative AI copilots, tool-call visualizations, and markdown artifacts",
  "author": "Mohammed Aqib <62829012+imaqib101@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/imaqib101/react-agentic-stream-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaqib101/react-agentic-stream-ui.git"
  },
  "bugs": {
    "url": "https://github.com/imaqib101/react-agentic-stream-ui/issues"
  },
  "keywords": [
    "react",
    "react18",
    "react19",
    "agentic-ai",
    "generative-ai",
    "streaming",
    "llm",
    "copilot",
    "ui-components",
    "typescript",
    "vitest"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^15.7.4",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
